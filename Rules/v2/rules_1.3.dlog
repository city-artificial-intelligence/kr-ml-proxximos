# 26 rules (11 Low + 4 Medium + 11 High)

[ ?enc, :hasEncounterRisk, risk:Low ] :-
    [ ?enc, rdf:type,               risk:PersonEncounter    ],
    [ ?enc, :hasProximityCategory,  risk:Close              ],
    [ ?enc, :hasDurationCategory,   risk:Instantaneous      ].

