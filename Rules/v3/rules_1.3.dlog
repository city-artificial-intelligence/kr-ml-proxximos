# risk stratification rules: 11 Low, 4 Medium, 15 High

# Low
[ ?enc, :hasEncounterRisk, risk:Low ] :-
    [ ?enc, rdf:type, risk:PersonEncounter ],
    [ ?enc, :hasProximityCategory, risk:Close ],
    [ ?enc, :hasDurationCategory, risk:Instantaneous ].

[ ?enc, :hasEncounterRisk, risk:Low ] :-
    [ ?enc, rdf:type, risk:PersonEncounter ],
    [ ?enc, :hasProximityCategory, risk:Close ],
    [ ?enc, :hasDurationCategory, risk:VeryBrief ].

[ ?enc, :hasEncounterRisk, risk:Low ] :-
    [ ?enc, rdf:type, risk:PersonEncounter ],
    [ ?enc, :hasProximityCategory, risk:Moderate ],
    [ ?enc, :hasDurationCategory, risk:Instantaneous ].

[ ?enc, :hasEncounterRisk, risk:Low ] :-
    [ ?enc, rdf:type, risk:PersonEncounter ],
    [ ?enc, :hasProximityCategory, risk:Moderate ],
    [ ?enc, :hasDurationCategory, risk:VeryBrief ].

[ ?enc, :hasEncounterRisk, risk:Low ] :-
    [ ?enc, rdf:type, risk:PersonEncounter ],
    [ ?enc, :hasProximityCategory, risk:Moderate ],
    [ ?enc, :hasDurationCategory, risk:Short ].

